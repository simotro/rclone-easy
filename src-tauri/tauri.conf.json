{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rclone-easy",
  "version": "0.1.0",
  "identifier": "RcloneEasy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "rclone-easy",
        "width": 800,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "simotro",
    "homepage": "https://github.com/simotro/rclone-easy",
    "copyright": "Copyright © 2026 simotro",
    "category": "Utility",
    "shortDescription": "Interfaccia grafica per rclone",
    "longDescription": "Un'interfaccia grafica semplice per rclone, pensata come alternativa più leggera a client come Insync, Google Drive Sync o MEGAsync, capace di collegarsi a decine di provider cloud diversi grazie al motore di rclone.",
    "icon": [
      "icons/icon.svg",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/rclone"],
    "linux": {
      "appimage": {
        "files": {
          "usr/share/icons/hicolor/scalable/apps/rclone-easy.svg": "icons/icon.svg"
        }
      },
      "deb": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/rclone-easy.svg": "icons/icon.svg"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/rclone-easy.svg": "icons/icon.svg"
        }
      }
    }
  }
}
